{
    "family": "srep1-dev-front-nginx-taskdef",
    "containerDefinitions": [
        {
            "name": "front-nginx",
            "image": "727646491820.dkr.ecr.ap-northeast-1.amazonaws.com/srep1-dev-front-nginx-repo:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp",
                    "name": "http-nginx"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "ENV",
                    "value": "dev"
                },
                {
                    "name": "API_SERVICE_HOST",
                    "value": "api-python"
                },
                {
                    "name": "API_SERVICE_PORT",
                    "value": "8080"
                }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/srep1-dev-front-nginx-taskdef",
                    "mode": "non-blocking",
                    "awslogs-create-group": "true",
                    "max-buffer-size": "25m",
                    "awslogs-region": "ap-northeast-1",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "taskRoleArn": "arn:aws:iam::727646491820:role/CustomECSTaskRole",
    "executionRoleArn": "arn:aws:iam::727646491820:role/CustomECSTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
    "placementConstraints": [],
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    }
} 