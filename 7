-- アプリケーションユーザーがいなければ作成（'ユーザー名'@'%'は全てのホストからアクセス可能）
CREATE USER IF NOT EXISTS 'srep1'@'%' IDENTIFIED BY 'password';

-- アプリケーションユーザーに全ての権限を付与
GRANT ALL PRIVILEGES ON *.* TO 'srep1'@'%';

-- GRANT（権限を付与）やREVOKE（権限を剥奪）で設定した権限を即時反映
FLUSH PRIVILEGES;

-- アプリケーションユーザー作成成功メッセージ
SELECT 'User created successfully';